{
  "name": "incidentmesh-concurrent-response",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.17.0",
  "files": [
    "dist",
    "scripts",
    "src",
    "README.md",
    "tsconfig.json",
    "tsconfig.build.json",
    "npm-shrinkwrap.json",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "demo": "tsx src/demo.ts",
    "benchmark": "tsx src/benchmark.ts",
    "demo:built": "node dist/demo.js",
    "replay": "tsx src/replay.ts",
    "replay:built": "node dist/replay.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "check": "npm run typecheck && npm test",
    "verify:built": "node dist/verify.js",
    "verify": "npm run check && npm run build && npm run verify:built",
    "ablation": "tsx src/ablation.ts",
    "replay:visual": "tsx src/replay-visual.ts",
    "degradation": "tsx src/degradation.ts",
    "provider:evidence:check": "node scripts/capture-provider-evidence.mjs --check",
    "provider:evidence:capture": "node scripts/capture-provider-evidence.mjs --execute"
  },
  "dependencies": {
    "@mozaik-ai/core": "4.0.5"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.3.3"
  },
  "description": "Concurrent incident-response agents with shared state, adaptive mitigation, and production-action interception.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1337isnot1337/incidentmesh.git"
  },
  "homepage": "https://github.com/1337isnot1337/incidentmesh#readme",
  "keywords": [
    "mozaik",
    "multi-agent",
    "incident-response",
    "concurrency",
    "ai-agents",
    "typescript"
  ]
}
